# Servidor
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Base de Datos PostgreSQL + PostGIS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geo_muebles
DB_USER=geo_app
DB_PASSWORD=changeme_dev_password

# Seguridad JWT y Hashing (en producción usar cadenas aleatorias de 64+ caracteres)
JWT_ACCESS_SECRET=cambia_esta_clave_access_de_al_menos_64_caracteres_aleatorios_12345
JWT_REFRESH_SECRET=cambia_esta_clave_refresh_de_al_menos_64_caracteres_aleatorios_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Reglas de Negocio Geoespaciales
DEFAULT_SEARCH_RADIUS_METERS=5000
MAX_SEARCH_RADIUS_METERS=10000
PIN_TTL_HOURS=24
RESERVATION_TTL_HOURS=2
MAX_ACTIVE_RESERVATIONS_PER_USER=2

# Media y Worker TTL
MEDIA_PUBLIC_BASE_URL=http://localhost:4000/uploads
CLEANUP_INTERVAL_SECONDS=60